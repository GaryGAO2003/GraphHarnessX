# Local reviews and agent/session snapshots. Curated provenance remains tracked.
review-snapshot*/
agent-snapshot*/
*.session.json
*.session.jsonl

# Agent run outputs (the whitelisted campaign archives live here on disk;
# they are several GB and are distributed separately, see recipe/gaia_evolver/runs/README.md)
runs/
!recipe/gaia_evolver/runs/
recipe/gaia_evolver/runs/*
!recipe/gaia_evolver/runs/README.md
traces/
sessions/
checkpoints*
logs/
*.log
meta_rounds/
experiments/overnight/

# GAIA benchmark data: gated on HuggingFace, must not be redistributed.
# Rebuild locally with: python experiments/build_gaia_subset.py
recipe/gaia_evolver/data/

# Analysis outputs (recomputable from the run archives)
experiments/analysis/out/

# Browser screenshots
screenshots/
*.png
*.jpg
*.jpeg
!experiments/docs/thesis/*.png
!experiments/docs/thesis/figures/*.jpg
!experiments/docs/thesis/figures/ucl_logo.png

