*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments / secrets
.venv*/
venv/
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.idea/
.vscode/
.claude/
.agents/
