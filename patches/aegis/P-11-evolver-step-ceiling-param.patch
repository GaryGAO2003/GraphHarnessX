diff --git a/harnessx/aegis/orchestrator.py b/harnessx/aegis/orchestrator.py
index 2b14743..8a16dbf 100644
--- a/harnessx/aegis/orchestrator.py
+++ b/harnessx/aegis/orchestrator.py
@@ -127,6 +127,11 @@ class AegisOrchestrator:
     min_actionability: float = 0.3
     # Benchmark context string forwarded to the evolver template.
     benchmark_context: str = ""
+    # Evolver tool-step ceiling. 200 is the official value; it is the constraint that
+    # actually binds (both Evolver runs of M13_pro_meta_103x3 hit exactly 200 steps
