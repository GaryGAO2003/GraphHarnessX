+    # Without this list the task vanishes from the round with no log line, no counter
+    # and no summary row, while `task_count` below still reports the full input set —
+    # a silently shortened evidence base reads downstream as a complete one.
+    missing: list[str] = []
+
     async def _one(task_id: str, traj_paths: list[Path]) -> None:
         async with sem:
             pattern = classify_pattern(pass_flags_by_task.get(task_id, []))
